{
  "name": "leafer-x-magnifier",
  "version": "0.1.0",
  "description": "Leafer 放大镜插件：指针悬停时用镜片局部放大画布，取样直接来自 Leafer 渲染结果",
  "keywords": [
    "leafer",
    "leafer-ui",
    "leafer-ui-plugins",
    "magnifier"
  ],
  "license": "MIT",
  "files": [
    "src",
    "types",
    "dist"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.esm.js",
    "module": "./dist/index.esm.js",
    "types": "./types/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.esm.js",
        "require": "./dist/index.cjs",
        "types": "./types/index.d.ts"
      }
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@leafer-ui/interface": "^2.0.4"
  },
  "devDependencies": {
    "@leafer-ui/core": "^2.2.3",
    "jsdom": "^29.1.1",
    "leafer-ui": "^2.2.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@leafer-ui/core": "^1.2.2 || ^2.0.0"
  },
  "peerDependenciesMeta": {
    "@leafer-ui/core": {
      "optional": true
    }
  }
}
