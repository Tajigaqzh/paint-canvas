{
  "name": "leafer-x-brush-eraser",
  "version": "0.1.0",
  "description": "Leafer 自由绘制与橡皮擦插件：指针手势采集、实时预览，数据通过事件交回宿主",
  "keywords": [
    "brush",
    "eraser",
    "freehand",
    "leafer",
    "leafer-ui",
    "leafer-ui-plugins"
  ],
  "license": "MIT",
  "files": [
    "src",
    "dist"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "publishConfig": {
    "main": "./dist/index.esm.js",
    "module": "./dist/index.esm.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "import": "./dist/index.esm.js",
        "require": "./dist/index.cjs",
        "types": "./dist/index.d.ts"
      }
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "dependencies": {
    "@leafer-ui/interface": "^2.0.4"
  },
  "devDependencies": {
    "@leafer-ui/core": "^2.2.3",
    "jsdom": "^29.1.1",
    "leafer-ui": "^2.2.3",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@leafer-ui/core": "^1.2.2 || ^2.0.0"
  },
  "peerDependenciesMeta": {
    "@leafer-ui/core": {
      "optional": true
    }
  }
}
